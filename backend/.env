# FastAPI
APP_NAME="GitHub Repo Fetcher"
APP_VERSION="1.0.0"
DEBUG=True
API_V1_PREFIX="/api/v1"
HOST="0.0.0.0"
PORT=8000

# MinIO Configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=github-repos
MINIO_SECURE=False

# GitHub
GITHUB_API_TIMEOUT=30

# Invoke-WebRequest -Uri "https://dl.min.io/server/minio/release/windows-amd64/minio.exe" -OutFile "minio.exe"
# mkdir minio-data
# .\minio.exe server .\minio-data --console-address ":9001"
# Web Console: http://127.0.0.1:9001 (where you manage buckets)


# MinIO Configuration
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=repositories

# Server Configuration
NODE_ENV=development

# KuzuDB Configuration (add later)
KUZU_DB_PATH=./data/kuzu

# Redis Configuration (for caching, add later)
REDIS_URL=redis://localhost:6379